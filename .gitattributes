# Normalize line endings in the repository to LF.
* text=auto eol=lf

# Shell scripts MUST be LF — CRLF breaks the shebang on Linux and macOS.
*.sh text eol=lf

# PowerShell is native to Windows; keep CRLF.
*.ps1 text eol=crlf

# Binary types, never diffed or line-ending converted.
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.xlsx binary
*.xls binary
